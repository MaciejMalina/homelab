# Skopiuj do .env i uzupełnij (.env nie trafia do gita).
PORT=8084

# Serwer: IP w LAN (po przejściu na 192.168.254.0/24 sprawdź w DHCP ZTE) albo IP Tailscale serwera
SERVER_IP=192.168.254.X
SERVER_MAC=4c:cc:6a:4a:33:6d
# Broadcast WoL — 255.255.255.255 działa w network_mode: host; można wpisać 192.168.254.255
WOL_BROADCAST=255.255.255.255
SERVER_SSH_USER=jpower

# Uptime Kuma -> Settings -> API Keys -> "Add API Key" (do odczytu /metrics)
KUMA_API_KEY=
# Opcjonalnie: nowy monitor typu Push w Kumie "Panel (telefon)" — wklej jego URL; brak sygnału = telefon padł
KUMA_PUSH_PANEL=

# Opcjonalnie: wspólny sekret dla przycisków/sterowania (ten sam wpisujesz w appce na telefonie).
# Pusty = bez tokena, jak jarvis_todo (tylko LAN/tailnet).
PANEL_TOKEN=

# Na ile minut dotyk budzi ekran; ile minut świeci ekran z alertem
WAKE_MIN=2
ALERT_MIN=30
