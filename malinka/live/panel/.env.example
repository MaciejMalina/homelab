# Skopiuj do .env i uzupełnij (.env nie trafia do gita). Puste = zakładka pokaże "nie skonfigurowano".
PORT=8084

# ---------- serwer (zawsze po LAN-ie! idle-shutdown ignoruje tylko ruch z 192.168.254.10;
#            zapytania po IP Tailscale trzymałyby serwer włączony)
SERVER_IP=192.168.254.11
SERVER_MAC=4c:cc:6a:4a:33:6d
WOL_BROADCAST=192.168.254.255
SERVER_SSH_USER=jpower

# ---------- Uptime Kuma: klucz API (Settings -> API Keys) ALBO slug strony statusu (bez klucza; tylko monitory z tej strony)
KUMA_API_KEY=
KUMA_STATUS_SLUG=brief
# Opcjonalnie: monitor typu Push "Panel (telefon)" — brak sygnału = telefon padł
KUMA_PUSH_PANEL=

# ---------- komputery z agentem C# (pc-agent/): nazwa|url|MAC (MAC do WoL; laptop po Wi-Fi bez MAC)
PCS=gaming|http://192.168.254.73:8765|;laptop|http://100.X.X.X:8765|
AGENT_TOKEN=

# ---------- media na serwerze (klucze: Sonarr/Radarr -> Settings -> General -> API Key; Jellyfin -> Panel -> Klucze API)
QBIT_URL=http://192.168.254.11:8080
QBIT_USER=
QBIT_PASS=
SONARR_URL=http://192.168.254.11:8989
SONARR_KEY=
RADARR_URL=http://192.168.254.11:7878
RADARR_KEY=
JELLYFIN_URL=http://192.168.254.11:8096
JELLYFIN_KEY=
GLANCES_URL=http://192.168.254.11:61208

# ---------- Dzień: kalendarz Nextcloud (CalDAV, hasło aplikacji), Paperless (token API)
NEXTCLOUD_CAL_URLS=http://192.168.254.11:8081/remote.php/dav/calendars/admin/personal/
NEXTCLOUD_USER=admin
NEXTCLOUD_PASS=
PAPERLESS_URL=http://192.168.254.11:8010
PAPERLESS_TOKEN=

# ---------- sieć: router ZTE MC889A Pro (hasło do panelu routera), AdGuard na malince
ZTE_URL=https://192.168.254.1
ZTE_PASS=
ADGUARD_URL=http://127.0.0.1:8080
ADGUARD_USER=
ADGUARD_PASS=

# ---------- pasek LED (płytka ESP8266 z WLED) — po wgraniu firmware wpisz jej adres
WLED_URL=

# ---------- gniazda z przedłużaczy ESPHome (przyciski na Przeglądzie): id|nazwa|adres przedłużacza|nazwa przełącznika w ESPHome
GNIAZDA=monitor|Monitor|http://192.168.254.40|Monitor;drukarka|Drukarka|http://192.168.254.40|Drukarka
GNIAZDA_HASLO=
# automat: twarz/dłoń przy biurku (kamera panelu) włącza to gniazdo; puste = bez automatu
OBECNOSC_GNIAZDO=monitor
# 0 = nigdy nie gaś samo (wyłączanie ręcznie: „wyłącz stanowisko”); N > 0 = zgaś po N minutach nieobecności
OBECNOSC_WYLACZ_MIN=0
# „Hey Jarvis, włącz / wyłącz stanowisko” - gniazda z GNIAZDA po przecinku (np. monitor,led)
STANOWISKO=monitor

# ---------- Docker (Serwery -> "Zarządzaj kontenerami"): nazwa|adres proxy|rw (wolno restartować) albo ro (tylko lista i logi)
# Hosty oddziel średnikiem. Malinka = proxy z docker-compose.yml (127.0.0.1:2375). Serwer (opcjonalnie): proxy po LAN-ie
# (192.168.254.11, NIGDY IP Tailscale — to trzymałoby serwer włączony i omijałoby sprawdzanie, czy śpi), najlepiej ro:
#   DOCKER_HOSTS=malinka|http://127.0.0.1:2375|rw;serwer|http://192.168.254.11:2375|ro
DOCKER_HOSTS=malinka|http://127.0.0.1:2375|rw
DOCKER_NIE_RESTARTUJ=jarvis_panel,jarvis_docker_proxy
# kontenery, z których niezdrowy stan jest Ci obojętny (nie liczą się jako problem), np. mountain-tracker
DOCKER_IGNORUJ=

# ---------- telefon: wspólny sekret (ten sam w appce i w .env bota); pusty = bez tokena
PANEL_TOKEN=
WAKE_MIN=2
ALERT_MIN=30
