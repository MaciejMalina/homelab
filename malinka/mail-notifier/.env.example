# Hasła aplikacji Google (16 znaków; spacje są ignorowane) — myaccount.google.com/apppasswords
GMAIL_1_USER=macmalonet783@gmail.com
GMAIL_1_PASS=
GMAIL_2_USER=maciejmalina19@gmail.com
GMAIL_2_PASS=

# Opcjonalnie
INTERWAL=60
FILTR=category:primary is:unread
# Konto bez kart (Główne/Oferty) w Gmailu — category:primary nic nie zwraca:
GMAIL_2_FILTR=is:unread -category:promotions -category:social -category:forums
# Uptime Kuma: monitor typu Push, interwał 120 s -> wklej URL push (bez parametrów)
KUMA_PUSH_URL=
# Cisza nocna: w tych godzinach przychodzą tylko kody 2FA i paczki, reszta zbiorczo po ciszy (puste = bez ciszy)
CISZA=23:00-07:00
# Przypomnienie o ważnym mailu, który nadal jest nieprzeczytany (godziny; 0 = wyłączone)
PRZYPOMNIJ_PO_H=24
