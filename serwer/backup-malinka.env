# =============================================================================
#  /etc/jarvis/backup-malinka.env — konfiguracja backupu malinki
#  chmod 0640, właściciel root:root (są tu ścieżki, nie hasła — hasło restica
#  leży osobno w /etc/jarvis/restic-pass)
# =============================================================================

# --- Malinka -----------------------------------------------------------------
PI_HOST=malinka                       # nazwa z /etc/hosts, IP LAN albo adres tailnet
PI_USER=bkp
PI_KEY=/root/.ssh/jarvis_backup

# --- Gdzie lądują kopie --------------------------------------------------------
# ZMIENIONE (2026-08-25): /mnt/telemetry zamiast /mnt/data.
# /mnt/telemetry to osobny fizyczny dysk 458GB, dziś prawie pusty — inny nośnik
# niż /mnt/data (główna macierz serwera). Dzięki temu backup malinki NIE leży
# na tym samym fizycznym dysku co reszta danych serwera — to jest ta różnica
# między "3 kopie na papierze" a "3 kopie, które faktycznie przetrwają awarię
# jednego dysku". Nadal nie jest to "offsite" (ten sam dach) — offsite zostaje
# osobnym punktem (B2 / dysk u rodziny), patrz docs/JARVIS-storage-i-roadmapa.md.
DEST_ROOT=/mnt/telemetry/backups/malinka
RESTIC_REPOSITORY=/mnt/telemetry/backups/restic-malinka
RESTIC_PASSWORD_FILE=/etc/jarvis/restic-pass

# --- Retencja ----------------------------------------------------------------
# Kasujemy wszystko starsze niż miesiąc. KEEP_LAST to bezpiecznik: nawet gdyby
# backup nie chodził przez pół roku, ostatnie 7 snapshotów nigdy nie znika.
RETENCJA_DNI=30
RESTIC_KEEP_LAST=7

# --- Alerty (wypełnij co najmniej jedno!) ------------------------------------
# Bez tego cichy fail backupu pozostanie niezauważony — dokładnie ryzyko P1 z audytu.
# Ten sam webhook, którego już używasz — NIE wklejaj go tu na stałe przed
# przeniesieniem sekretów do sops (punkt 7 na liście, na koniec). Na razie
# wstaw ręcznie na serwerze, nie w pliku, który wejdzie do gita.
DISCORD_WEBHOOK=<SECRET_DISCORD_WEBHOOK>
NTFY_URL=
HEALTHCHECK_URL=

# --- Reszta ------------------------------------------------------------------
LOCKFILE_IDLE=/etc/jarvis-no-autoshutdown
LOG=/var/log/jarvis-backup-malinka.log
