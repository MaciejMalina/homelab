# Skopiuj do .env na serwerze (chmod 600) i wypełnij.
# WireGuard: PO ROTACJI kluczy w panelu AirVPN — stare klucze wyciekły w
# plaintext na czacie 2026-09-07 i zostały pierwotnie użyte 1:1 na serwerze,
# rotacja wciąż OTWARTA na 2026-09-07 (wieczór).
# .env NIE wchodzi do gita (patrz .gitignore obok).
AIRVPN_WIREGUARD_ADDRESSES=10.x.x.x/32
AIRVPN_WIREGUARD_PRIVATE_KEY=
AIRVPN_WIREGUARD_PRESHARED_KEY=
