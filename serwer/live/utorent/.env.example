# Skopiuj do .env na serwerze (chmod 600) i wypełnij.
# WireGuard: PO ROTACJI kluczy w panelu AirVPN — stare klucze wyciekły w
# plaintext na czacie 2026-09-07 i zostały pierwotnie użyte 1:1 na serwerze,
# rotacja wciąż OTWARTA na 2026-09-07 (wieczór).
# .env NIE wchodzi do gita (patrz .gitignore obok).
AIRVPN_WIREGUARD_ADDRESSES=10.x.x.x/32
AIRVPN_WIREGUARD_PRIVATE_KEY=
AIRVPN_WIREGUARD_PRESHARED_KEY=

# HTTP proxy (port 8888) i Shadowsocks (port 8388) gluetuna - wystawione na
# LAN/Tailscale serwera, zabezpieczone loginem/hasłem (decyzja Macieja
# 2026-09-07: z hasłem, nie otwarte). Wymyśl własne wartości, nie zostawiaj
# pustych - przy pustym USER/PASSWORD gluetun i tak wystartuje, ale proxy
# będzie żądać pustych poświadczeń, czyli faktycznie otwarte.
GLUETUN_HTTPPROXY_USER=
GLUETUN_HTTPPROXY_PASSWORD=
GLUETUN_SHADOWSOCKS_PASSWORD=
